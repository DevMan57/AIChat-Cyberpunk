<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="ai.moonshine.voice" />

    <!-- Network permissions for model download -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Audio permissions for voice cloning and speech recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- Storage permissions for saving voice profiles -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    
    <!-- Foreground service for model download -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- Wake lock for keeping device awake during TTS -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SmolChatApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmolLMAndroid"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        tools:targetApi="31">
        
        <activity
            android:name=".ui.screens.manage_asr.ManageASRActivity"
            android:exported="false"
            android:label="@string/title_activity_app_settings"
            android:theme="@style/Theme.SmolLMAndroid" />
            
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmolLMAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".ui.screens.chat.ChatActivity"
            android:exported="true"
            android:label="💬 AI Chat"
            android:windowSoftInputMode="adjustResize">
            <!-- This intent-filter is used to receive text from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        
        <activity 
            android:name=".ui.screens.model_download.DownloadModelActivity"
            android:label="Download Model" />
            
        <activity 
            android:name=".ui.screens.manage_tasks.ManageTasksActivity"
            android:label="Manage Tasks" />
            
        <!-- Voice Cloning Activity -->
        <activity 
            android:name=".ui.screens.voice.VoiceCloningActivity"
            android:exported="false"
            android:label="Voice Cloning"
            android:theme="@style/Theme.SmolLMAndroid" />
            
    </application>

</manifest>
